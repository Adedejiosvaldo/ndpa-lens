{
  "name": "@ndpa/checks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "golden:capture": "node scripts/golden-capture.mjs"
  },
  "dependencies": {
    "@ndpa/scan-engine": "workspace:*",
    "@ndpa/schema": "workspace:*",
    "@ndpa/vendors": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "fixtures": "workspace:*",
    "playwright": "^1.65.1",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
