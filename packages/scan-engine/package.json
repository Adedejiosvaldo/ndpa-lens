{
  "name": "@ndpa/scan-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./url-check": {
      "types": "./dist/url-check.d.ts",
      "import": "./dist/url-check.js",
      "require": "./dist/url-check.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/url-check.ts src/types.ts --format esm,cjs --dts --clean --external playwright --external undici",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ndpa/schema": "workspace:*",
    "@ndpa/storage": "workspace:*",
    "cheerio": "^1.2.0",
    "playwright": "^1.65.1",
    "undici": "^7.30.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "selfsigned": "^5.5.0",
    "testcontainers": "^12.2.2",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
