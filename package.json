{
  "name": "ndpa-lens",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "dev:infra": "bash infra/dev/up.sh",
    "dev:infra:down": "docker compose -f infra/dev/docker-compose.yml down",
    "dev:infra:reset": "docker compose -f infra/dev/docker-compose.yml down -v"
  },
  "devDependencies": {
    "turbo": "^2.11.13",
    "typescript": "^5.9.3"
  }
}
