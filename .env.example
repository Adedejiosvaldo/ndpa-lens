# Stage 1 local development. Copy to .env and keep it out of git.
# Matches infra/dev/docker-compose.yml (`pnpm dev:infra`). Production values come
# from the SOPS-encrypted env (Step 33). Later steps add their own variables.

# PostgreSQL 16. Three roles (Step 06):
#   owner      runs migrations only
#   ndpa_api   the API; row-level security limits it to one organisation per request
#   ndpa_auth  Better Auth only; identity tables
# `pnpm --filter api db:setup` applies migrations, then gives the two roles these passwords.
MIGRATION_DATABASE_URL=postgres://ndpa:ndpa@127.0.0.1:5432/ndpa
DB_API_PASSWORD=dev-api-password-change-me
DB_AUTH_PASSWORD=dev-auth-password-change-me
DATABASE_URL=postgres://ndpa_api:dev-api-password-change-me@127.0.0.1:5432/ndpa
AUTH_DATABASE_URL=postgres://ndpa_auth:dev-auth-password-change-me@127.0.0.1:5432/ndpa

# Redis 7 (BullMQ queue)
REDIS_URL=redis://127.0.0.1:6379

# S3-compatible object storage. Dev: SeaweedFS. Prod: Cloudflare R2
# (S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com, S3_REGION=auto).
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=auto
S3_BUCKET=ndpa-evidence
S3_ACCESS_KEY_ID=ndpa-dev-access
S3_SECRET_ACCESS_KEY=ndpa-dev-secret-change-me
S3_FORCE_PATH_STYLE=true

# Better Auth: signs tokens and encrypts TOTP secrets. Generate: openssl rand -base64 48
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdefghij

# Which proxy hops may set X-Forwarded-For. Dev: loopback. Prod behind Cloudflare and Caddy: set per Step 33.
TRUST_PROXY=loopback

# Email. Dev: Mailpit SMTP (UI on http://localhost:8025). Prod: Resend.
SMTP_URL=smtp://127.0.0.1:1025
EMAIL_FROM="NDPA Lens <no-reply@ndpa.test>"

# Public URLs
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
