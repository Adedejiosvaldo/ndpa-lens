# AI policy review on our OpenRouter key: one free review per person per day.
OPENROUTER_API_KEY=
# Claude Haiku 5.5, about $0.002 per review.
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
# Limits (rolling 24 hours). The total cap is the hard limit on spend.
AI_FREE_PER_PERSON_PER_DAY=1
AI_FREE_PER_IP_PER_DAY=20
AI_FREE_TOTAL_PER_DAY=300

# Optional browser channel. The scanner tries Chrome, Edge, then bundled Chromium.
PLAYWRIGHT_CHANNEL=chrome

# --- Deployment (docker compose) ---
# Your domain(s). Point their DNS A/AAAA records at this server first.
DOMAIN=lens.example.com
# Other websites allowed to call /api/scan from the browser (comma-separated). Empty = same site only.
ALLOWED_ORIGINS=
