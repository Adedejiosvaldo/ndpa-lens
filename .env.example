# Optional: enables contextual policy review without entering a key in the UI.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=

# Optional browser channel. The scanner tries Chrome, Edge, then bundled Chromium.
PLAYWRIGHT_CHANNEL=chrome

# --- Deployment (docker compose) ---
# Your domain(s). Point their DNS A/AAAA records at this server first.
DOMAIN=lens.example.com
# Other websites allowed to call /api/scan from the browser (comma-separated). Empty = same site only.
ALLOWED_ORIGINS=
