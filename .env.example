# Stage 1 local development. Copy to .env and keep it out of git.
# Matches infra/dev/docker-compose.yml (`pnpm dev:infra`). Production values come
# from the SOPS-encrypted env (Step 33). Later steps add their own variables.

# PostgreSQL 16 (owner role; migrations run as this user)
DATABASE_URL=postgres://ndpa:ndpa@127.0.0.1:5432/ndpa

# Redis 7 (BullMQ queue)
REDIS_URL=redis://127.0.0.1:6379

# S3-compatible object storage. Dev: SeaweedFS. Prod: Cloudflare R2
# (S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com, S3_REGION=auto).
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=auto
S3_BUCKET=ndpa-evidence
S3_ACCESS_KEY_ID=ndpa-dev-access
S3_SECRET_ACCESS_KEY=ndpa-dev-secret-change-me
S3_FORCE_PATH_STYLE=true

# Email. Dev: Mailpit SMTP (UI on http://localhost:8025). Prod: Resend.
SMTP_URL=smtp://127.0.0.1:1025
EMAIL_FROM="NDPA Lens <no-reply@ndpa.test>"

# Public URLs
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
