# Copy to deploy/.env on the VPS and fill in. docker compose reads it automatically.

# Our OpenRouter key for the AI privacy-policy review (one free per person per day).
OPENROUTER_API_KEY=
# Claude Haiku 5.5, about $0.002 per review.
OPENROUTER_MODEL=anthropic/claude-haiku-5.5

# Limits on the key (rolling 24 hours). The total cap is the hard limit on spend.
AI_FREE_PER_PERSON_PER_DAY=1
AI_FREE_PER_IP_PER_DAY=20
AI_FREE_TOTAL_PER_DAY=300

# Scan limits.
SCAN_RATE_LIMIT=8
SCAN_MAX_CONCURRENT=2

# Optional: other websites allowed to call /api/scan from a browser (comma-separated).
# Leave empty; the app's own pages are same-origin.
# ALLOWED_ORIGINS=

# Docker network of the Caddy that serves this app. Default matches azaman-engine.
# PROXY_NETWORK=deploy_default
